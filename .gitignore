# Environnements virtuels
.venv/
.venv_build/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo

# Artefacts de build PyInstaller (voir build-onefile.bat/build-onedir.bat) — régénérables, jamais versionnés
build/
dist/
*.spec

# Données générées par le programme (jamais versionnées : régénérables) —
# `**/` couvre aussi bien un fichier direct (cache/http_cache.sqlite3, une
# exécution --cache-dir=cache non isolée par commune) que la structure
# isolée par commune utilisée en pratique (cache/<commune>/http_cache.sqlite3,
# voir --cache-dir dans main.py) : un simple `cache/*.sqlite3` ne matchait
# pas ce deuxième cas, laissant ces fichiers suivis par erreur.
cache/**/*.sqlite3
logs/**/*.log
logs/**/*.log.*
output/**/*.xlsx
output/**/*.xls

# Fichiers de verrouillage Excel
~$*.xlsx
~$*.xls

# Configuration locale / secrets
.env
.licence

# Accès par commune (outils/gerer_licences.py) : mots de passe/sels réels
# des clients, jamais versionnés — seule la publication manuelle vers
# l'emplacement public (voir utils/licence.py) est censée les exposer,
# et uniquement sous forme de hash, jamais en clair.
outils/autorisations.json

# Éditeurs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
